PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smartexam
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
FIELD_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key
CLIENT_ORIGIN=http://localhost:5173
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
# Optional sender label/address; defaults to SmartExam <GMAIL_USER>
GMAIL_FROM=
